using System.IO;
using UnityEditor;
using UnityEngine;

public static class BuildPhysicalWaterBundle
{
    private const string MaterialDirectory = "Assets/PhysicalWaterBundle";
    private const string MaterialPath = MaterialDirectory + "/R4V9N1_PhysicalOceanMaterial.mat";
    private const string VisualPrefabPath = MaterialDirectory + "/R4V9N1_PhysicalOceanVisual.prefab";
    private const string BundleName = "physicalwater_assets";

    public static void Build()
    {
        Directory.CreateDirectory(MaterialDirectory);

        Shader shader = Shader.Find("R4V9N1/Physical Ocean Surface");
        if (shader == null)
        {
            throw new System.InvalidOperationException("Could not find shader: R4V9N1/Physical Ocean Surface");
        }

        if (!shader.isSupported)
        {
            throw new System.InvalidOperationException(
                "Physical Ocean shader exists but is unsupported on the active Unity graphics device/build target. " +
                "Do not package a dead shader; fix D3D11 compilation first.");
        }

        Material material = AssetDatabase.LoadAssetAtPath<Material>(MaterialPath);
        if (material == null)
        {
            material = new Material(shader)
            {
                name = "R4V9N1_PhysicalOceanMaterial"
            };
            AssetDatabase.CreateAsset(material, MaterialPath);
        }
        else
        {
            material.shader = shader;
        }

        material.SetColor("_DeepColor", new Color(0.0f, 0.075f, 0.14f, 0.76f));
        material.SetColor("_ShallowColor", new Color(0.02f, 0.23f, 0.31f, 0.68f));
        material.SetColor("_FoamColor", new Color(0.78f, 0.94f, 1.0f, 0.86f));
        material.SetFloat("_Smoothness", 0.92f);
        material.SetFloat("_Metallic", 0f);
        material.SetFloat("_FresnelPower", 4.2f);
        material.SetFloat("_RefractionStrength", 0.08f);
        material.SetFloat("_NormalStrength", 0.44f);
        material.SetFloat("_FoamStrength", 0.72f);
        material.SetFloat("_GlintStrength", 0.11f);
        material.SetFloat("_StormWhitecap", 0.32f);
        material.SetFloat("_VisualWaveStrength", 0.82f);
        material.SetFloat("_WaveAmplitude", 1.0f);
        material.SetFloat("_RippleScale", 0.24f);
        material.SetFloat("_CausticStrength", 0.055f);
        EditorUtility.SetDirty(material);

        GameObject visualPrefab = AssetDatabase.LoadAssetAtPath<GameObject>(VisualPrefabPath);
        GameObject visualRoot = new GameObject("R4V9N1_PhysicalOceanVisual");
        visualRoot.transform.position = Vector3.zero;
        MeshFilter meshFilter = visualRoot.AddComponent<MeshFilter>();
        MeshRenderer meshRenderer = visualRoot.AddComponent<MeshRenderer>();
        meshFilter.sharedMesh = CreateUnityPreviewMesh();
        meshRenderer.sharedMaterial = material;

        GameObject foam = new GameObject("R4V9N1_PhysicalOceanFoamEmitter");
        foam.transform.SetParent(visualRoot.transform, false);
        ParticleSystem foamSystem = foam.AddComponent<ParticleSystem>();
        ParticleSystem.MainModule foamMain = foamSystem.main;
        foamMain.playOnAwake = false;
        foamMain.loop = false;
        foamMain.startLifetime = 1.6f;
        foamMain.startSpeed = 0.35f;
        foamMain.startSize = 0.22f;
        foamMain.startColor = new Color(0.70f, 0.93f, 1f, 0.55f);
        foamMain.simulationSpace = ParticleSystemSimulationSpace.World;
        ParticleSystem.EmissionModule foamEmission = foamSystem.emission;
        foamEmission.enabled = false;
        ParticleSystem.ShapeModule foamShape = foamSystem.shape;
        foamShape.shapeType = ParticleSystemShapeType.Circle;
        foamShape.radius = 1.6f;
        ParticleSystemRenderer foamRenderer = foam.GetComponent<ParticleSystemRenderer>();
        foamRenderer.renderMode = ParticleSystemRenderMode.HorizontalBillboard;
        foamRenderer.sharedMaterial = material;

        if (visualPrefab == null)
        {
            PrefabUtility.SaveAsPrefabAsset(visualRoot, VisualPrefabPath);
        }
        else
        {
            PrefabUtility.SaveAsPrefabAssetAndConnect(visualRoot, VisualPrefabPath, InteractionMode.AutomatedAction);
        }

        Object.DestroyImmediate(visualRoot);

        AssetImporter importer = AssetImporter.GetAtPath(MaterialPath);
        importer.assetBundleName = BundleName;
        importer.SaveAndReimport();
        AssetDatabase.SaveAssets();

        string outputDirectory = Path.GetFullPath(Path.Combine(
            Application.dataPath,
            "..",
            "..",
            "Valheim",
            "source",
            "PhysicalWater",
            "dist"));
        Directory.CreateDirectory(outputDirectory);

        AssetBundleBuild build = new AssetBundleBuild
        {
            assetBundleName = BundleName,
            assetNames = new[] { MaterialPath, VisualPrefabPath }
        };

        BuildPipeline.BuildAssetBundles(
            outputDirectory,
            new[] { build },
            BuildAssetBundleOptions.ChunkBasedCompression | BuildAssetBundleOptions.ForceRebuildAssetBundle,
            BuildTarget.StandaloneWindows64);

        string bundlePath = Path.Combine(outputDirectory, BundleName);
        if (!File.Exists(bundlePath))
        {
            throw new FileNotFoundException("AssetBundle build did not produce expected output.", bundlePath);
        }

        Debug.Log("Built PhysicalWater asset bundle: " + bundlePath);
    }

    private static Mesh CreateUnityPreviewMesh()
    {
        const int resolution = 17;
        const float size = 64f;
        Mesh mesh = new Mesh
        {
            name = "R4V9N1_PhysicalOceanVisualPreviewMesh"
        };
        Vector3[] vertices = new Vector3[resolution * resolution];
        Color[] colors = new Color[vertices.Length];
        int[] triangles = new int[(resolution - 1) * (resolution - 1) * 6];

        for (int z = 0; z < resolution; z++)
        {
            for (int x = 0; x < resolution; x++)
            {
                int index = x + z * resolution;
                float px = ((float)x / (resolution - 1) - 0.5f) * size;
                float pz = ((float)z / (resolution - 1) - 0.5f) * size;
                vertices[index] = new Vector3(px, 0f, pz);
                colors[index] = new Color(1f, 0.1f, 0.35f, 1f);
            }
        }

        int t = 0;
        for (int z = 0; z < resolution - 1; z++)
        {
            for (int x = 0; x < resolution - 1; x++)
            {
                int a = x + z * resolution;
                int b = a + 1;
                int c = a + resolution;
                int d = c + 1;
                triangles[t++] = a;
                triangles[t++] = c;
                triangles[t++] = b;
                triangles[t++] = b;
                triangles[t++] = c;
                triangles[t++] = d;
            }
        }

        mesh.vertices = vertices;
        mesh.colors = colors;
        mesh.triangles = triangles;
        mesh.RecalculateBounds();
        mesh.RecalculateNormals();
        return mesh;
    }
}
