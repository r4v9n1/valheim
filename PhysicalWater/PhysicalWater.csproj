<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PhysicalWater</AssemblyName>
    <RootNamespace>PhysicalWater</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(ValheimDir)\valheim_Data\Managed</GameManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(ValheimDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricWaterSettings.cs" Link="Volumetric\VolumetricWaterSettings.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricWaterDiagnostics.cs" Link="Volumetric\VolumetricWaterDiagnostics.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricWaterDomain.cs" Link="Volumetric\VolumetricWaterDomain.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricFlipDiagnostics.cs" Link="Volumetric\VolumetricFlipDiagnostics.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricFlipDensityDiagnostics.cs" Link="Volumetric\VolumetricFlipDensityDiagnostics.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricFlipSettings.cs" Link="Volumetric\VolumetricFlipSettings.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricFlipDomain.cs" Link="Volumetric\VolumetricFlipDomain.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricSolidGeometrySdf.cs" Link="Volumetric\VolumetricSolidGeometrySdf.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricFiniteDomain.cs" Link="Volumetric\VolumetricFiniteDomain.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricStreamingDomain.cs" Link="Volumetric\VolumetricStreamingDomain.cs" />
    <Compile Include="..\..\..\UnityPhysicalOcean\Runtime\VolumetricFluidStateSnapshot.cs" Link="Volumetric\VolumetricFluidStateSnapshot.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(GameManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.DirectorModule">
      <HintPath>$(GameManagedDir)\UnityEngine.DirectorModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
